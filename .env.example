# Copy to .env and fill in. Load with:
#   uv run --env-file .env news-verifier
#   docker run --env-file .env -p 8080:8080 news-verifier

# Optional: enables Google Fact Check Tools (TFC, MyGoPen, AFP, ...).
# Without it, only Cofacts is queried. Get a key at https://console.cloud.google.com/apis/credentials
# after enabling the "Fact Check Tools API".
GOOGLE_FACTCHECK_API_KEY=

# HTTP port and bind address (defaults shown).
PORT=8080
HOST=0.0.0.0
